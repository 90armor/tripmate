# TripMate environment template.
# Setup: cp .env.example .env   — then replace placeholders as noted.
# .env is git-ignored. Never commit real secrets. Values below are for LOCAL development only.

# PostgreSQL from docker-compose.yml (host port 5433; 5432 is left free for a local Homebrew Postgres).
DATABASE_URL=postgres://tripmate:tripmate@127.0.0.1:5433/tripmate

# Integration tests only. The database name must end in _test and differ from DATABASE_URL;
# the test setup refuses to run otherwise. Created automatically by docker/postgres/init.
TEST_DATABASE_URL=postgres://tripmate:tripmate@127.0.0.1:5433/tripmate_test

# Better Auth. Generate a real secret with:  openssl rand -base64 32
# The placeholder works for local development but is rejected when NODE_ENV=production
# or when BETTER_AUTH_URL's host is not localhost / 127.0.0.1.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output
# Public base URL of this app (used by Better Auth for callbacks and cookies).
BETTER_AUTH_URL=http://localhost:3000
